{
  "name": "containor",
  "version": "6.2.0",
  "description": "Simple DI container for Javascript with Typescript support",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "build": "rm -rf lib; rm -rf dist; rm -rf types; rollup -c && tsc --declaration --emitDeclarationOnly --declarationDir types",
    "test": "npm run lint; jest",
    "lint": "eslint .; prettier . --check",
    "fix": "eslint . --fix; prettier . --write",
    "prepublishOnly": "npm run test; npm run build",
    "prepare": "husky",
    "docs": "docsify serve ./docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ngerritsen/containor.git"
  },
  "keywords": [
    "javascript",
    "di",
    "dependency",
    "injection",
    "ioc",
    "container",
    "typescript"
  ],
  "author": "Niels Gerritsen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ngerritsen/containor/issues"
  },
  "homepage": "https://ngerritsen.github.io/containor",
  "files": [
    "dist",
    "lib",
    "types"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "ts-jest": "^29.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
